<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- CookieProfile.content is stored in this database. -->
        <exclude domain="database" path="app_database" />
        <exclude domain="database" path="app_database-wal" />
        <exclude domain="database" path="app_database-shm" />
        <exclude domain="database" path="app_database-journal" />
    </cloud-backup>
    <device-transfer>
        <!-- Keep session cookies off device-to-device transfers as well. -->
        <exclude domain="database" path="app_database" />
        <exclude domain="database" path="app_database-wal" />
        <exclude domain="database" path="app_database-shm" />
        <exclude domain="database" path="app_database-journal" />
    </device-transfer>
</data-extraction-rules>
